# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0
# Get a free key (no card) at https://console.groq.com
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODELS_CONFIG_PATH=config/models.yaml
PRICES_CONFIG_PATH=config/prices.yaml
ROUTER_MODEL_PATH=models/router-v1.joblib
RATE_LIMIT_PER_MINUTE=60
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=86400
SMALL_MAX_PROMPT_TOKENS=3000
# Leave empty to disable tracing. With the compose stack: http://localhost:6006/v1/traces
PHOENIX_ENDPOINT=
